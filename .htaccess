DirectoryIndex index.html index.php

# Custom Error Pages (DirectAdmin Native SSI Views)
ErrorDocument 400 /400.shtml
ErrorDocument 401 /401.shtml
ErrorDocument 403 /403.shtml
ErrorDocument 404 /404.shtml
ErrorDocument 500 /500.shtml

# SSI Configuration via Server-Parsed Handler
<FilesMatch "\.(html|shtml)$">
    AddType text/html .html
    AddHandler server-parsed .html
    Options +Includes
</FilesMatch>

# Favicon Fallback
RewriteRule ^favicon\.ico$ assets/favicon/favicon.ico [L]

RewriteEngine On

# 1. SECURITY: Force HTTPS
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. SECURITY: Prevent Directory Browsing
Options -Indexes

# 3. SECURITY: Protect System, Source & Environment Files
<FilesMatch "^(\.|\.env|\.log|\.md|\.iml|\.git|\.yml|\.sh)">
    Order allow,deny
    Deny from all
</FilesMatch>

# 4. SECURITY: Strict Database & Transaction Protection
# Block direct downloads of SQLite files, WAL journals, and user archives
<FilesMatch "\.(sqlite|sqlite3|db|db3|wal|shm)$">
    Order allow,deny
    Deny from all
</FilesMatch>

RewriteRule ^data/rasta\.sqlite$ - [F,L,NC]
RewriteRule ^data/users\.json$ - [F,L,NC]
RewriteRule ^data/presence\.json$ - [F,L,NC]

# 5. ROUTING: REST API Bridge
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.*)$ api.php?endpoint=$1 [QSA,L]

# 6. MIME Types & Cache Rules
AddType image/svg+xml .svg
AddType font/woff2 .woff2

<IfModule mod_expires.c>
    ExpiresActive On
    # Authoritative static assets
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"

    # Dynamic JSON responses and active endpoints must never cache
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>